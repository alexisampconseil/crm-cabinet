# URL publique absolue de l'application — requise pour générer des liens
# de collecte exploitables par email (sans elle, les liens envoyés par email
# sont relatifs et cassés par le tracking de clics Brevo).
# NEXT_PUBLIC_APP_URL est lu côté client ET serveur ; APP_URL est utilisée
# comme repli si la variable NEXT_PUBLIC_* n'est pas définie.
# Ne jamais utiliser localhost/127.0.0.1 ici en production.
NEXT_PUBLIC_APP_URL=https://votre-domaine.fr
APP_URL=https://votre-domaine.fr
